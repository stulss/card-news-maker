{
  "name": "card-news-maker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "prebuild": "node scripts/generate-notices.mjs",
    "check:licenses": "node scripts/generate-notices.mjs --check",
    "test": "vitest run",
    "verify": "npm run lint && tsc -b && npm run check:licenses && npm test && npm run build && npm run test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/black-han-sans": "^5.3.0",
    "@fontsource/do-hyeon": "^5.3.0",
    "@fontsource/gaegu": "^5.3.0",
    "@fontsource/gowun-batang": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@fontsource/jua": "^5.3.0",
    "@fontsource/nanum-pen-script": "^5.3.0",
    "@fontsource/noto-color-emoji": "^5.3.2",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/noto-serif-kr": "^5.3.1",
    "@huggingface/transformers": "^4.3.2",
    "konva": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.5",
    "use-image": "^1.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.7"
  }
}
